// Generated by scripts/build-access-rules.cjs; edit the generator and regenerate.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ACCESS POLICY GENERATED START
    match /userAccess/{uid} { allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin()); allow write: if false; }
    match /accessHistory/{id} { allow read, write: if false; }
    match /accessSystem/{id} { allow read: if isSuperAdmin(); allow write: if false; }
    function accessForCaller(caller) {
      return exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
        ? get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data
        : {'status': 'active', 'scope': caller.role in ['admin','superadmin'] ? 'all' : 'owned-assigned', 'raceIds': [], 'overrides': {}};
    }
    function access() {
      return accessForCaller(callerDoc().data);
    }
    function presetForRole(role, action) {
      return role == 'superadmin' || (role == 'admin' && !action.matches('personal[.].*') && action != 'highlights.playlist')
        || (role == 'organizer' && !action.matches('engraving[.].*') && !action.matches('highlights[.].*') && action != 'users.view' && action != 'timing.correct')
        || (role == 'runner' && action.matches('personal[.].*'));
    }
    function preset(action) {
      return presetForRole(callerDoc().data.role, action);
    }
    function directAction(p, o, role, action) {
      return (action in p ? p[action] : (action in o ? o[action] : presetForRole(role, action))) == true;
    }
    function permBase(action, role, approved, p, o) {
      return (role != 'organizer' || approved || action == 'personal.register')
        && (role == 'superadmin' || directAction(p, o, role, action));
    }
    function actionDepsOk(p, o, role, action) {
      return (action in ['highlights.manage','highlights.settings'] ? directAction(p, o, role, 'highlights.view') : true)
        && (action != 'highlights.playlist' || (directAction(p, o, role, 'highlights.view') && directAction(p, o, role, 'highlights.settings')))
        && (action in ['routes.create','routes.edit','routes.media','routes.archive'] ? directAction(p, o, role, 'routes.view') : true)
        && (action != 'routes.publish' || (directAction(p, o, role, 'routes.view') && directAction(p, o, role, 'routes.edit')))
        && (action != 'routes.assign' || (directAction(p, o, role, 'routes.view') && directAction(p, o, role, 'race.view')));
    }
    function callerHasAction(acc, role, action) {
      return directAction(acc.get('permissions', {}), acc.get('overrides', {}), role, action);
    }
    function fallbackPermission(action) {
      return callerHasAction(access(), callerDoc().data.role, action);
    }
    function permissionForCaller(action, caller, acc) {
      let role = caller.role;
      let p = acc.get('permissions', {});
      let o = acc.get('overrides', {});
      return acc.status == 'active'
        && (role != 'organizer' || caller.get('approved', false) == true || action.matches('personal[.].*'))
        && (role == 'superadmin'
          || (directAction(p, o, role, action)
            && (!(action in ['highlights.manage','highlights.settings','highlights.playlist','routes.create','routes.edit','routes.media','routes.publish','routes.assign','routes.archive'])
              || actionDepsOk(p, o, role, action))));
    }
    function permission(action) {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && permissionForCaller(action, callerDoc().data, access());
    }
    function raceScopeForCaller(raceId, caller, acc) {
      let race = get(/databases/$(database)/documents/races/$(raceId)).data;
      // Super Admin remains global even if an older userAccess document has
      // an obsolete selected/owned scope.
      return caller.role == 'superadmin' || acc.scope == 'all'
        || (acc.scope == 'selected' && raceId in acc.raceIds)
        || (acc.scope == 'owned-assigned' && (race.createdBy == request.auth.uid || request.auth.uid in race.get('organizerIds', [])));
    }
    function raceScope(raceId) {
      return raceScopeForCaller(raceId, callerDoc().data, access());
    }
    function racePermission(action, raceId) { return permission(action) && raceScope(raceId); }
    function changed(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields); }
    // ACCESS POLICY GENERATED END

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null && (request.auth.token.email_verified == true
        || exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // One-time codes, reset grants, delivery limits and payment sessions are backend-only.
    match /accountChallenges/{id} { allow read, write: if false; }
    match /accountResetGrants/{id} { allow read, write: if false; }
    match /accountRateLimits/{id} { allow read, write: if false; }
    match /payments/{id} { allow read, write: if false; }
    match /pendingRegistrations/{id} { allow read, write: if false; }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }



    function isSuperAdmin() { return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && callerDoc().data.role == 'superadmin' && access().status == 'active'; }

    // Admins retain operational access; irreversible and account-management
    // actions are reserved for the Super Admin account alone.


    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'kiahzeh@gmail.com';
    }

    function superAdminAlreadyClaimed() {
      return exists(/databases/$(database)/documents/system/meta)
        && get(/databases/$(database)/documents/system/meta).data.keys().hasAll(['superAdminClaimed'])
        && get(/databases/$(database)/documents/system/meta).data.superAdminClaimed == true;
    }

    function canBootstrapSuperAdmin(data) {
      return isSuperAdminEmail()
        && !superAdminAlreadyClaimed()
        && data.role == 'superadmin'
        && data.approved == true;
    }



    // An approved organizer may operate a race they created or a race whose
    // owner explicitly added their account to its organizer team.


    function hasValidRegistrationId(regId, data) {
      return regId == data.uid + '_' + data.raceId;
    }

    function isRemovedAccount(uid) {
      return exists(/databases/$(database)/documents/removedAccounts/$(uid));
    }

    function ownsRecordedSplit(raceId, bibNumber) {
      let directRegistration = exists(/databases/$(database)/documents/runners/$(request.auth.uid + '_' + raceId))
        && get(/databases/$(database)/documents/runners/$(request.auth.uid + '_' + raceId)).data.bibNumber == bibNumber;
      // Imported/Google Form runners can securely link their physical bib to
      // their account through the server-side QR claim flow. The claim stores
      // only the profile needed for their own race screen.
      let bibClaim = exists(/databases/$(database)/documents/runnerClaims/$(request.auth.uid + '_' + raceId))
        && get(/databases/$(database)/documents/runnerClaims/$(request.auth.uid + '_' + raceId)).data.bibNumber == bibNumber;
      return isSignedIn() && (directRegistration || bibClaim);
    }

    // ========== USERS / ROLES ==========

    function isValidUsername(username) {
      return username is string
        && username.size() >= 3 && username.size() <= 24
        && username.matches('^[a-z0-9][a-z0-9_.-]*$');
    }

    // Friendship documents are directional (request sender first), so this
    // checks both possible IDs. It is used only for the small, safe friend
    // profile/activity documents below—not for private user or runner docs.
    function isFriendOf(uid) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + uid))
        || exists(/databases/$(database)/documents/friendships/$(uid + '_' + request.auth.uid))
      );
    }

    // When a username exists on a profile, it must be backed by the immutable
    // index document in the same transaction/batch. This prevents a profile
    // from claiming a username that resolves to someone else's login.
    function hasValidUsernameBinding(uid, data) {
      return !data.keys().hasAny(['username']) || (
        isValidUsername(data.username)
        && existsAfter(/databases/$(database)/documents/usernameIndex/$(data.username))
        && getAfter(/databases/$(database)/documents/usernameIndex/$(data.username)).data.uid == uid
        && getAfter(/databases/$(database)/documents/usernameIndex/$(data.username)).data.email == data.email
      );
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'approved', 'createdAt'])
        && data.email is string && data.displayName is string
        && data.role is string && (data.role == 'superadmin' || data.role == 'admin' || data.role == 'organizer' || data.role == 'runner')
        && data.approved is bool
        && data.createdAt is string
        // Runner accounts are always auto-approved.
        && (data.role != 'runner' || data.approved == true)
        // Organizer accounts always start unapproved; only a Super Admin can flip that later.
        && (data.role != 'organizer' || data.approved == false)
        // The one-time Super Admin bootstrap is restricted to the owner email.
        && (data.role != 'superadmin' || canBootstrapSuperAdmin(data))
        && hasValidUsernameBinding(data.uid, data);
    }

    function hasSafeProfileDetails(data) {
      return (!data.keys().hasAny(['nickname']) || data.nickname == null || (data.nickname is string && data.nickname.size() <= 30))
        && (!data.keys().hasAny(['photoURL']) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 100000))
        && (!data.keys().hasAny(['coverURL']) || data.coverURL == null || (data.coverURL is string && data.coverURL.size() <= 150000))
        && (!data.keys().hasAny(['coverPreset']) || data.coverPreset == null || (data.coverPreset is string && data.coverPreset.size() <= 40))
        && (!data.keys().hasAny(['bio']) || data.bio == null || (data.bio is string && data.bio.size() <= 160))
        && (!data.keys().hasAny(['location']) || data.location == null || (data.location is string && data.location.size() <= 80))
        && (!data.keys().hasAny(['runClub']) || data.runClub == null || (data.runClub is string && data.runClub.size() <= 80))
        && (!data.keys().hasAny(['favoriteDistance']) || data.favoriteDistance == null || (data.favoriteDistance is string && data.favoriteDistance.size() <= 30))
        && (!data.keys().hasAny(['socialLink']) || data.socialLink == null || (data.socialLink is string && data.socialLink.size() <= 160))
        && (!data.keys().hasAny(['emergencyContactName']) || data.emergencyContactName == null || (data.emergencyContactName is string && data.emergencyContactName.size() <= 100))
        && (!data.keys().hasAny(['emergencyContactPhone']) || data.emergencyContactPhone == null || (data.emergencyContactPhone is string && data.emergencyContactPhone.size() <= 30))
        && (!data.keys().hasAny(['shirtSize']) || data.shirtSize == null || (data.shirtSize is string && data.shirtSize.size() <= 20))
        && (!data.keys().hasAny(['medicalNotes']) || data.medicalNotes == null || (data.medicalNotes is string && data.medicalNotes.size() <= 600))
        && (!data.keys().hasAny(['username']) || data.username == null || data.username == '' || isValidUsername(data.username))
        && (!data.keys().hasAny(['marketingOptIn']) || data.marketingOptIn == null || data.marketingOptIn is bool)
        && (!data.keys().hasAny(['marketingUpdatedAt']) || data.marketingUpdatedAt == null || (data.marketingUpdatedAt is string && data.marketingUpdatedAt.size() <= 60));
    }

    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isSuperAdmin() || permission('users.view') || (permission('race.team') && resource.data.role == 'organizer' && resource.data.approved == true);
      allow create: if request.auth != null && request.auth.token.email_verified == true && request.auth.uid == uid
        && !isRemovedAccount(uid) && isValidUserCreate(request.resource.data)
        && request.resource.data.role in ['runner','organizer','superadmin']
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email;
      allow update: if request.auth != null && request.auth.uid == uid
        && !isRemovedAccount(uid)
        && (!exists(/databases/$(database)/documents/userAccess/$(uid)) || get(/databases/$(database)/documents/userAccess/$(uid)).data.get('status', 'active') == 'active')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','nickname','photoURL','coverURL','coverPreset','bio','location','runClub','favoriteDistance','socialLink','emergencyContactName','emergencyContactPhone','shirtSize','medicalNotes','username','marketingOptIn','marketingUpdatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 100
        && hasSafeProfileDetails(request.resource.data)
        && (!changed(['username']) || ((!resource.data.keys().hasAny(['username']) || resource.data.username == null || resource.data.username == '') && hasValidUsernameBinding(uid, request.resource.data)));
      allow delete: if request.auth != null && request.auth.uid == uid && resource.data.role != 'superadmin';
    }

    // Firebase Auth uses email/password internally. This immutable directory
    // lets the sign-in form resolve an exact username without exposing the
    // private user profile collection. Only direct document gets are public;
    // username enumeration/listing is blocked.
    match /usernameIndex/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && !isRemovedAccount(request.auth.uid)
        && username == request.resource.data.username
        && isValidUsername(username)
        && request.resource.data.keys().hasOnly(['username', 'uid', 'email', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is string;
      allow update: if false;
      // A username may only be released in the same batch that removes its
      // matching account profile; this prevents users from changing handles.
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // A tombstone prevents a removed Firebase login from recreating a profile
    // in the app. Full Firebase Auth deletion additionally requires a trusted
    // Firebase Admin backend, never browser code.
    match /removedAccounts/{uid} { allow read: if isSuperAdmin(); allow write: if false; }

    // ========== RUNNER FRIENDS (SAFE, CONSENT-BASED VIEW) ==========

    function isSafeFriendProfile(data, uid, username) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'displayName', 'nickname', 'photoURL', 'updatedAt'])
        && data.uid == uid && data.username == username
        && isValidUsername(data.username)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!data.keys().hasAny(['nickname']) || (data.nickname is string && data.nickname.size() <= 30))
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 100000))
        && data.updatedAt is string;
    }

    // Username search uses a direct document read, not a query, to avoid
    // directory enumeration. This directory deliberately excludes email.
    match /friendDirectory/{username} {
      allow get: if isSignedIn() && !isRemovedAccount(request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn()
        && !isRemovedAccount(request.auth.uid)
        && (request.auth.token.email_verified == true
          || exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        && (!exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
          || get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.get('status', 'active') == 'active')
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/usernameIndex/$(username))
        && getAfter(/databases/$(database)/documents/usernameIndex/$(username)).data.uid == request.auth.uid
        && isSafeFriendProfile(request.resource.data, request.auth.uid, username);
      allow update: if isSignedIn()
        && !isRemovedAccount(request.auth.uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
          || get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.get('status', 'active') == 'active')
        && isSafeFriendProfile(request.resource.data, request.auth.uid, username);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendProfiles/{uid} {
      allow get: if isSignedIn() && !isRemovedAccount(request.auth.uid) && (request.auth.uid == uid || isFriendOf(uid));
      allow list: if false;
      allow create, update: if isSignedIn()
        && !isRemovedAccount(request.auth.uid)
        && (!exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
          || get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.get('status', 'active') == 'active')
        && request.auth.uid == uid
        && isSafeFriendProfile(request.resource.data, uid, request.resource.data.username);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /friendActivities/{uid} {
      allow get: if isSignedIn() && !isRemovedAccount(request.auth.uid) && (request.auth.uid == uid || isFriendOf(uid));
      allow list: if false;
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && !isRemovedAccount(request.auth.uid)
        && (!exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
          || get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.get('status', 'active') == 'active')
        && request.resource.data.keys().hasOnly(['uid', 'recentRaces', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.recentRaces is list && request.resource.data.recentRaces.size() <= 6
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
