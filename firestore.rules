    }

    match /friendRequests/{requestId} {
      allow read: if permission('personal.friends') && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if permission('personal.friends')
        && requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'fromUsername', 'fromDisplayName', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid
        && isValidUsername(request.resource.data.fromUsername)
        && request.resource.data.fromDisplayName is string && request.resource.data.fromDisplayName.size() >= 1 && request.resource.data.fromDisplayName.size() <= 100
        && request.resource.data.status == 'pending' && request.resource.data.createdAt is string;
      allow update: if permission('personal.friends') && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.fromUsername == resource.data.fromUsername
        && request.resource.data.fromDisplayName == resource.data.fromDisplayName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.respondedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if permission('personal.friends') && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if permission('personal.friends') && resource.data.members.hasAny([request.auth.uid]);
      allow create: if permission('personal.friends')
        && friendshipId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'members', 'createdAt'])
        && request.resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid is string && request.resource.data.fromUid != request.auth.uid
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll([request.resource.data.fromUid, request.resource.data.toUid])
        && request.resource.data.createdAt is string
        && existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.fromUid + '_' + request.resource.data.toUid))
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.fromUid + '_' + request.resource.data.toUid)).data.status == 'accepted';
      allow delete: if permission('personal.friends') && resource.data.members.hasAny([request.auth.uid]);
      allow update: if false;
    }

    match /raceInvites/{inviteId} {
      allow read: if permission('personal.invites') && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if permission('personal.invites')
        && inviteId == request.resource.data.fromUid + '_' + request.resource.data.toUid + '_' + request.resource.data.raceId
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'raceId', 'raceName', 'raceDate', 'fromDisplayName', 'createdAt', 'status'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid
        && isFriendOf(request.resource.data.toUid)
        && request.resource.data.raceId is string
        && exists(/databases/$(database)/documents/races/$(request.resource.data.raceId))
        && request.resource.data.raceName is string && request.resource.data.raceName.size() >= 1 && request.resource.data.raceName.size() <= 150
        && request.resource.data.raceDate is string
        && request.resource.data.fromDisplayName is string && request.resource.data.fromDisplayName.size() >= 1 && request.resource.data.fromDisplayName.size() <= 100
        && request.resource.data.createdAt is string && request.resource.data.status == 'pending';
      allow update: if permission('personal.invites') && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'opened';
      allow delete: if permission('personal.invites') && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // ========== SYSTEM / SUPER ADMIN BOOTSTRAP ==========

    match /system/meta {
      allow read: if true;
      // Only the configured owner email can mark the one-time claim complete.
      allow create, update: if isSuperAdminEmail()
        && !superAdminAlreadyClaimed()
        && request.resource.data.superAdminClaimed == true;
    }

    // ========== RACES & CHECKPOINTS ==========

    function raceUpdateAllowed(raceId) {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && raceUpdateAllowedWithCaller(raceId, callerDoc().data);
    }
    function raceUpdateAllowedWithCaller(raceId, caller) {
      let acc = accessForCaller(caller);
      let role = caller.role;
      let approved = caller.get('approved', false) == true;
      let p = acc.get('permissions', {});
      let o = acc.get('overrides', {});
      let fields = request.resource.data.diff(resource.data).affectedKeys();
      let scoped = true;
      return acc.status == 'active' && raceScopeForCaller(raceId, caller, acc) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
        && (!fields.hasAny(['livestreamUrl']) || request.resource.data.get('livestreamUrl', '') == '' || isSafeHttpUrl(request.resource.data.livestreamUrl))
        && (!fields.hasAny(['routeMapUrl']) || request.resource.data.get('routeMapUrl', '') == '' || isSafeHttpUrl(request.resource.data.routeMapUrl))
        && (!fields.hasAny(['routeGpxUrl']) || request.resource.data.get('routeGpxUrl', '') == '' || isSafeStorageOrHttpsUrl(request.resource.data.routeGpxUrl))
        && fields.hasOnly(['name','date','inclusions','checkpoints','ageCategories','youngestRunnerAwardEnabled','oldestRunnerAwardEnabled','distances','entryCategories','registrationOpen','registrationCloseDate','onlinePaymentEnabled','paymentFeeMode','manualPaymentEnabled','manualPaymentInstructions','manualPaymentQrImage','posterImage','inclusionImage','routeGpxUrl','routeGpxFileName','routeGpxUploadedAt','raceBibTemplateImage','raceBibCustomFont','raceBibLayout','raceBibTemplatesByDistance','raceBibTemplatesByEntryCategory','raceBibShowRaffleNumber','raceBibShowQrCode','organizerIds','gunStartTime','waveStartTimes','completedAt','liveBroadcastEnabled','livestreamUrl','routeMapUrl','finishReviewWindowMs','disqualifiedBibs'])
        && (!fields.hasAny(['finishReviewWindowMs']) || (permBase('timing.correct', role, approved, p, o) && request.resource.data.finishReviewWindowMs is number && request.resource.data.finishReviewWindowMs >= 0 && request.resource.data.finishReviewWindowMs <= 60000))
        && (!fields.hasAny(['disqualifiedBibs']) || ((permBase('timing.correct', role, approved, p, o) || permBase('timing.scan', role, approved, p, o)) && request.resource.data.disqualifiedBibs is map && request.resource.data.disqualifiedBibs.size() <= 500))
        && (!fields.hasAny(['name','date','inclusions']) || permBase('race.edit', role, approved, p, o))
        && (!fields.hasAny(['checkpoints','ageCategories','youngestRunnerAwardEnabled','oldestRunnerAwardEnabled','entryCategories']) || permBase('race.categories', role, approved, p, o))
        && (!fields.hasAny(['distances']) || (permBase('race.categories', role, approved, p, o) && permBase('payment.configure', role, approved, p, o)))
        && (!fields.hasAny(['registrationOpen','registrationCloseDate']) || permBase('race.registration', role, approved, p, o) || (permBase('timing.finish', role, approved, p, o) && fields.hasAny(['completedAt']) && request.resource.data.registrationOpen == false))
        && (!fields.hasAny(['onlinePaymentEnabled','paymentFeeMode','manualPaymentEnabled','manualPaymentInstructions','manualPaymentQrImage']) || permBase('payment.configure', role, approved, p, o))
        && (!fields.hasAny(['posterImage','inclusionImage','routeGpxUrl','routeGpxFileName','routeGpxUploadedAt']) || permBase('race.artwork', role, approved, p, o))
        && (!fields.hasAny(['raceBibTemplateImage','raceBibCustomFont','raceBibLayout','raceBibTemplatesByDistance','raceBibTemplatesByEntryCategory','raceBibShowRaffleNumber','raceBibShowQrCode']) || permBase('race.bibs', role, approved, p, o))
        && (!fields.hasAny(['organizerIds']) || (permBase('race.team', role, approved, p, o) && (resource.data.createdBy == request.auth.uid || (role == 'superadmin'))))
        && (!fields.hasAny(['liveBroadcastEnabled']) || permBase('hub.publish', role, approved, p, o))
        && (!fields.hasAny(['livestreamUrl','routeMapUrl']) || permBase('hub.manage', role, approved, p, o))
        && (!fields.hasAny(['completedAt']) || (request.resource.data.get('completedAt', null) == null ? permBase('timing.reopen', role, approved, p, o) : permBase('timing.finish', role, approved, p, o) && getAfter(/databases/$(database)/documents/liveResults/$(raceId)).data.updatedAt == request.resource.data.completedAt))
        && (!fields.hasAny(['gunStartTime','waveStartTimes']) || permBase('timing.reset', role, approved, p, o) || (permBase('timing.start', role, approved, p, o) && !resource.data.get('waveStartTimes', {}).diff(request.resource.data.get('waveStartTimes', {})).affectedKeys().hasAny(resource.data.get('waveStartTimes', {}).keys()) && resource.data.get('gunStartTime', null) == null));
    }
    match /races/{raceId} {
      allow read: if true;
      allow create: if permission('race.create') && request.resource.data.createdBy == request.auth.uid && request.resource.data.id == raceId
        && request.resource.data.get('createdAt', '') is string
        && (!request.resource.data.keys().hasAny(['livestreamUrl']) || request.resource.data.livestreamUrl == '' || isSafeHttpUrl(request.resource.data.livestreamUrl))
        && (!request.resource.data.keys().hasAny(['routeMapUrl']) || request.resource.data.routeMapUrl == '' || isSafeHttpUrl(request.resource.data.routeMapUrl))
        && (!request.resource.data.keys().hasAny(['routeGpxUrl']) || request.resource.data.routeGpxUrl == '' || isSafeStorageOrHttpsUrl(request.resource.data.routeGpxUrl))
        && !request.resource.data.keys().hasAny(['gunStartTime','waveStartTimes','completedAt'])
        && (!request.resource.data.keys().hasAny(['posterImage','inclusionImage']) || permission('race.artwork'))
        && (!request.resource.data.keys().hasAny(['routeGpxUrl','routeGpxFileName','routeGpxUploadedAt']) || permission('race.artwork'))
        && (!request.resource.data.keys().hasAny(['raceBibTemplateImage','raceBibCustomFont','raceBibLayout','raceBibTemplatesByDistance','raceBibTemplatesByEntryCategory','raceBibShowRaffleNumber','raceBibShowQrCode']) || permission('race.bibs'))
        && (request.resource.data.get('organizerIds', []).size() == 0 || permission('race.team'))
        && (!(request.resource.data.get('onlinePaymentEnabled', false) || request.resource.data.get('manualPaymentEnabled', false)) || permission('payment.configure'));
      allow update: if raceUpdateAllowed(raceId);
      allow delete: if isSuperAdmin() && raceScope(raceId);
    }

    // ========== RUNNER PROFILES ==========

    // Payment state is written exclusively by the trusted PayMongo webhook
    // function (Firebase Admin SDK bypasses these browser rules). This keeps a
    // runner from marking a free/pending registration as paid in DevTools.
    function paymentFields() {
      return ['paymentStatus', 'paymentId', 'paymentMethod', 'paymentAmount', 'paymentReference', 'paymentPaidAt'];
    }

    function hasNoPaymentMetadata(data) {
      return !data.keys().hasAny(paymentFields());
    }

    function hasValidPaymentMetadata(data) {
      return !data.keys().hasAny(paymentFields()) || (
        data.paymentStatus is string
        && data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40
        && data.paymentAmount is number && data.paymentAmount >= 0
        && (
          // A runner may reserve a slot through the organizer's approved
          // manual-payment flow. It is intentionally not a paid result.
          (data.paymentStatus == 'pending'
            && data.paymentMethod == 'manual'
            // Older pending reservations predate the reference-number field;
            // keep them operable while requiring it for all new reservations.
            && (!data.keys().hasAny(['paymentReference']) || (data.paymentReference is string && data.paymentReference.size() >= 4 && data.paymentReference.size() <= 100))
            && !data.keys().hasAny(['paymentId', 'paymentPaidAt']))
          ||
          (data.paymentStatus == 'paid'
            && data.paymentId is string && data.paymentId.size() >= 8 && data.paymentId.size() <= 120
            && data.paymentPaidAt is string
            // Online payments do not carry a manual reference, while a paid
            // manual reservation must retain the reference supplied by runner.
            && (!data.keys().hasAny(['paymentReference']) || (data.paymentReference is string && data.paymentReference.size() >= 4 && data.paymentReference.size() <= 100)))
        )
      );
    }

    function paymentMetadataUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(paymentFields());
    }

    function organizerConfirmsManualPayment() {
      return racePermission('payment.confirm', resource.data.raceId)
        && resource.data.paymentStatus == 'pending'
        && resource.data.paymentMethod == 'manual'
        && request.resource.data.paymentStatus == 'paid'
        && request.resource.data.paymentMethod == 'manual'
        && request.resource.data.paymentAmount == resource.data.paymentAmount
        && (!resource.data.keys().hasAny(['paymentReference'])
          || request.resource.data.paymentReference == resource.data.paymentReference)
        && request.resource.data.paymentId is string
        && request.resource.data.paymentId.size() >= 8 && request.resource.data.paymentId.size() <= 120
        && request.resource.data.paymentPaidAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(paymentFields());
    }

    function isSafeHttpUrl(url) {
      return url is string && url.size() >= 8 && url.size() <= 2048 && url.matches('^https?://[^\\s]+$');
    }

    function isSafeStorageOrHttpsUrl(url) {
      return url is string && url.size() >= 8 && url.size() <= 2048
        && url.matches('^(https://[^\\s]+|http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?/[^\\s]+)$');
    }

    function isKnownRaceDistance(distances, label) {
      return distances.size() == 0
        || (distances.size() > 0 && distances[0].label == label)
        || (distances.size() > 1 && distances[1].label == label)
        || (distances.size() > 2 && distances[2].label == label)
        || (distances.size() > 3 && distances[3].label == label)
        || (distances.size() > 4 && distances[4].label == label)
        || (distances.size() > 5 && distances[5].label == label)
        || (distances.size() > 6 && distances[6].label == label)
        || (distances.size() > 7 && distances[7].label == label)
        || (distances.size() > 8 && distances[8].label == label)
        || (distances.size() > 9 && distances[9].label == label)
        || (distances.size() > 10 && distances[10].label == label)
        || (distances.size() > 11 && distances[11].label == label)
        || distances.size() > 12;
    }

    function distanceRequiresPayment(distances, label) {
      return (distances.size() > 0 && distances[0].label == label && distances[0].get('price', 0) > 0)
        || (distances.size() > 1 && distances[1].label == label && distances[1].get('price', 0) > 0)
        || (distances.size() > 2 && distances[2].label == label && distances[2].get('price', 0) > 0)
        || (distances.size() > 3 && distances[3].label == label && distances[3].get('price', 0) > 0)
        || (distances.size() > 4 && distances[4].label == label && distances[4].get('price', 0) > 0)
        || (distances.size() > 5 && distances[5].label == label && distances[5].get('price', 0) > 0)
        || (distances.size() > 6 && distances[6].label == label && distances[6].get('price', 0) > 0)
        || (distances.size() > 7 && distances[7].label == label && distances[7].get('price', 0) > 0)
        || (distances.size() > 8 && distances[8].label == label && distances[8].get('price', 0) > 0)
        || (distances.size() > 9 && distances[9].label == label && distances[9].get('price', 0) > 0)
        || (distances.size() > 10 && distances[10].label == label && distances[10].get('price', 0) > 0)
        || (distances.size() > 11 && distances[11].label == label && distances[11].get('price', 0) > 0)
        || distances.size() > 12;
    }

    function manualAmountCoversDistance(distances, label, amount) {
      return !distanceRequiresPayment(distances, label)
        || (distances.size() > 0 && distances[0].label == label && amount >= distances[0].get('price', 0))
        || (distances.size() > 1 && distances[1].label == label && amount >= distances[1].get('price', 0))
        || (distances.size() > 2 && distances[2].label == label && amount >= distances[2].get('price', 0))
        || (distances.size() > 3 && distances[3].label == label && amount >= distances[3].get('price', 0))
        || (distances.size() > 4 && distances[4].label == label && amount >= distances[4].get('price', 0))
        || (distances.size() > 5 && distances[5].label == label && amount >= distances[5].get('price', 0))
        || (distances.size() > 6 && distances[6].label == label && amount >= distances[6].get('price', 0))
        || (distances.size() > 7 && distances[7].label == label && amount >= distances[7].get('price', 0))
        || (distances.size() > 8 && distances[8].label == label && amount >= distances[8].get('price', 0))
        || (distances.size() > 9 && distances[9].label == label && amount >= distances[9].get('price', 0))
        || (distances.size() > 10 && distances[10].label == label && amount >= distances[10].get('price', 0))
        || (distances.size() > 11 && distances[11].label == label && amount >= distances[11].get('price', 0));
    }

    function selfRegistrationAllowed(data) {
      return exists(/databases/$(database)/documents/races/$(data.raceId))
        && selfRegistrationWithRace(data, get(/databases/$(database)/documents/races/$(data.raceId)).data);
    }

    function selfRegistrationWithRace(data, race) {
      let raceDistances = race.get('distances', []);
      return race.get('registrationOpen', true)
        && isKnownRaceDistance(raceDistances, data.distance)
        && (
          (hasNoPaymentMetadata(data)
            && (raceDistances.size() > 0
              ? !distanceRequiresPayment(raceDistances, data.distance)
              : (!race.get('onlinePaymentEnabled', false) && !race.get('manualPaymentEnabled', false))))
          || createsManualPaymentReservationForRace(data, race, raceDistances)
        );
    }

    function createsManualPaymentReservation(data) {
      return exists(/databases/$(database)/documents/races/$(data.raceId))
        && createsManualPaymentReservationForRace(
          data,
          get(/databases/$(database)/documents/races/$(data.raceId)).data,
          get(/databases/$(database)/documents/races/$(data.raceId)).data.get('distances', [])
        );
    }

    function createsManualPaymentReservationForRace(data, race, raceDistances) {
      return data.paymentStatus == 'pending'
        && data.paymentMethod == 'manual'
        && data.paymentAmount is number && data.paymentAmount >= 0
        && data.paymentReference is string && data.paymentReference.size() >= 4 && data.paymentReference.size() <= 100
        && !data.keys().hasAny(['paymentId', 'paymentPaidAt'])
        && race.manualPaymentEnabled == true
        && isKnownRaceDistance(raceDistances, data.distance)
        && manualAmountCoversDistance(raceDistances, data.distance, data.paymentAmount);
    }

    function isValidRunnerProfile(data) {
      return data.keys().hasAll(['uid', 'raceId', 'fullName', 'bibNumber', 'distance', 'gender', 'age', 'createdAt'])
        && data.uid is string
        && data.raceId is string
        // Team records keep the combined member names in fullName. A five
        // person Group can naturally exceed the normal individual-name limit,
        // while Solo names retain the tighter 100-character validation.
        && data.fullName is string && data.fullName.size() >= 1
        && (
          data.fullName.size() <= 100
          || (
            data.keys().hasAny(['entryCategory'])
            && data.entryCategory is string
            && (data.entryCategory == 'duo' || data.entryCategory == 'trio' || data.entryCategory == 'group')
            && data.fullName.size() <= 500
          )
        )
        && data.bibNumber is string && data.bibNumber.size() >= 1 && data.bibNumber.size() <= 20
        && data.distance is string
        && data.gender is string && (data.gender == 'male' || data.gender == 'female')
        && data.age is int && data.age >= 1 && data.age <= 120
        && (!data.keys().hasAny(['ageNotProvided']) || data.ageNotProvided is bool)
        && (!data.keys().hasAny(['isFreeSlot']) || data.isFreeSlot is bool)
        && data.createdAt is string
        && (!data.keys().hasAny(['emergencyContactName']) || (data.emergencyContactName is string && data.emergencyContactName.size() >= 1 && data.emergencyContactName.size() <= 100))
        && (!data.keys().hasAny(['emergencyContactPhone']) || (data.emergencyContactPhone is string && data.emergencyContactPhone.size() >= 4 && data.emergencyContactPhone.size() <= 30))
        && (!data.keys().hasAny(['chipId']) || data.chipId is string)
        && (!data.keys().hasAny(['startsAfterBib']) || (data.startsAfterBib is string && data.startsAfterBib.size() >= 1 && data.startsAfterBib.size() <= 20 && data.startsAfterBib != data.bibNumber))
        && (!data.keys().hasAny(['kitClaimedAt']) || data.kitClaimedAt is string)
        && (!data.keys().hasAny(['shirtSize']) || (data.shirtSize is string && data.shirtSize.size() <= 20))
        && (!data.keys().hasAny(['entryCategory']) || (data.entryCategory is string && (data.entryCategory == 'solo' || data.entryCategory == 'duo' || data.entryCategory == 'trio' || data.entryCategory == 'group')))
        && (!data.keys().hasAny(['teamName']) || (data.teamName is string && data.teamName.size() >= 1 && data.teamName.size() <= 100))
        // Imported Group rosters can have more than the four members used by
        // the standard online-registration form. Keep a practical cap while
        // allowing five-member (and other larger) shared-bib Group teams.
        && (!data.keys().hasAny(['teamMembers']) || (data.teamMembers is list && data.teamMembers.size() >= 2 && data.teamMembers.size() <= 12))
        && hasValidPaymentMetadata(data);
    }

    // Doc id is {uid}_{raceId} - one entry per registration, so a runner can hold
    // many concurrent race registrations instead of a single overwritten profile.
    function runnerUpdateAllowed(regId) {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && runnerUpdateAllowedWithCaller(regId, callerDoc().data);
    }
    function runnerUpdateAllowedWithCaller(regId, caller) {
      let acc = accessForCaller(caller);
      let role = caller.role;
      let approved = caller.get('approved', false) == true;
      let p = acc.get('permissions', {});
      let o = acc.get('overrides', {});
      let fields = request.resource.data.diff(resource.data).affectedKeys();
      let scoped = raceScopeForCaller(resource.data.raceId, caller, acc);
      return acc.status == 'active' && isValidRunnerProfile(request.resource.data) && hasValidRegistrationId(regId, request.resource.data)
        && request.resource.data.uid == resource.data.uid && request.resource.data.raceId == resource.data.raceId && request.resource.data.createdAt == resource.data.createdAt
        && (organizerConfirmsManualPayment() || (paymentMetadataUnchanged()
          && fields.hasOnly(['fullName','gender','age','ageNotProvided','shirtSize','emergencyContactName','emergencyContactPhone','entryCategory','teamName','teamMembers','distance','bibNumber','chipId','startsAfterBib','kitClaimedAt'])
          && (!fields.hasAny(['chipId']) || (permBase('roster.chips', role, approved, p, o) && scoped))
          && (!fields.hasAny(['bibNumber']) || (permBase('roster.bibs', role, approved, p, o) && scoped))
          && (!fields.hasAny(['startsAfterBib']) || (permBase('roster.edit', role, approved, p, o) && scoped))
          && (!fields.hasAny(['kitClaimedAt']) || (permBase('roster.kits', role, approved, p, o) && scoped))
          && (!fields.hasAny(['fullName','gender','age','ageNotProvided','shirtSize','emergencyContactName','emergencyContactPhone','entryCategory','teamName','teamMembers','distance']) || (permBase('roster.edit', role, approved, p, o) && scoped) || (permBase('personal.register', role, approved, p, o) && resource.data.uid == request.auth.uid && (!fields.hasAny(['distance','entryCategory']) || resource.data.get('paymentStatus', '') == '')))));
    }
    function runnerCreateAllowed(regId) {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isValidRunnerProfile(request.resource.data) && hasValidRegistrationId(regId, request.resource.data)
        && runnerCreateAllowedWithCaller(callerDoc().data);
    }
    function runnerCreateAllowedWithCaller(caller) {
      let acc = accessForCaller(caller);
      let role = caller.role;
      let approved = caller.get('approved', false) == true;
      let p = acc.get('permissions', {});
      let o = acc.get('overrides', {});
      let scoped = raceScopeForCaller(request.resource.data.raceId, caller, acc);
      return acc.status == 'active' && (hasNoPaymentMetadata(request.resource.data) || createsManualPaymentReservation(request.resource.data))
        && !request.resource.data.keys().hasAny(['kitClaimedAt','chipId','startsAfterBib'])
        && ((permBase('roster.add', role, approved, p, o) && scoped) || (permBase('roster.import', role, approved, p, o) && scoped) || (request.resource.data.get('isFreeSlot', false) && (permBase('roster.slots', role, approved, p, o) && scoped)) || (permBase('personal.register', role, approved, p, o) && request.resource.data.uid == request.auth.uid && !request.resource.data.get('isFreeSlot', false) && selfRegistrationAllowed(request.resource.data)));
    }
    match /runners/{regId} {
      allow read: if racePermission('roster.view', resource.data.raceId) || (isSignedIn() && resource.data.uid == request.auth.uid && (permission('personal.register') || permission('personal.results') || permission('personal.bibs') || permission('personal.certificates')));
      allow create: if runnerCreateAllowed(regId);
      allow update: if runnerUpdateAllowed(regId);
      allow delete: if (isSuperAdmin() && raceScope(resource.data.raceId)) || racePermission('roster.remove', resource.data.raceId) || (permission('personal.register') && resource.data.uid == request.auth.uid && resource.data.get('paymentStatus', '') != 'paid' && !resource.data.keys().hasAny(['chipId','kitClaimedAt']));
    }

    // Per race+distance sequence counters, incremented transactionally when a
    // runner registers so two simultaneous registrations can't land on the
    // same bib number. No PII - just an integer, same trust level as chipReads.
    // A server-side QR claim lets a Google Form/imported runner attach their
    // own physical bib to their personal account without exposing the roster.
    // Browser clients can read only their own claim and can never forge one.
    match /runnerClaims/{claimId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid
        && (permission('personal.register') || permission('personal.results') || permission('personal.bibs') || permission('personal.certificates'));
      allow write: if false;
    }

    match /bibCounters/{counterId} {
      allow read: if permission('personal.register') || permission('roster.add') || permission('roster.slots');
      // Counters contain no private data. Only bounded monotonic increments are permitted.
      allow create: if request.resource.data.keys().hasOnly(['count','raceId']) && request.resource.data.raceId is string && counterId.matches(request.resource.data.raceId + '_.*') && request.resource.data.count is int && request.resource.data.count > 0 && exists(/databases/$(database)/documents/races/$(request.resource.data.raceId)) && ((permission('personal.register') && request.resource.data.count <= 20) || ((racePermission('roster.add', request.resource.data.raceId) || racePermission('roster.slots', request.resource.data.raceId)) && request.resource.data.count <= 5000));
      allow update: if request.resource.data.keys().hasOnly(['count','raceId']) && request.resource.data.raceId is string && (!('raceId' in resource.data) || request.resource.data.raceId == resource.data.raceId) && counterId.matches(request.resource.data.raceId + '_.*') && request.resource.data.count is int && request.resource.data.count >= resource.data.count && ((permission('personal.register') && request.resource.data.count <= resource.data.count + 20) || ((racePermission('roster.add', request.resource.data.raceId) || racePermission('roster.slots', request.resource.data.raceId)) && request.resource.data.count <= resource.data.count + 5000));
    }

    // ========== TIMING CHIP READS ==========

    function isValidChipRead(data) {
      return data.keys().hasAll(['raceId', 'bibNumber', 'checkpointId', 'timestamp', 'source', 'recordedBy', 'createdAt'])
        && data.raceId is string
        && data.bibNumber is string && data.bibNumber.size() >= 1 && data.bibNumber.size() <= 20
        && data.checkpointId is string
        && data.timestamp is string
        && data.source is string && (data.source == 'manual' || data.source == 'rfid-bridge')
        && data.recordedBy is string
        && data.createdAt is string
        && (!data.keys().hasAny(['chipId']) || data.chipId is string);
    }

    match /chipReads/{readId} {
      allow read: if racePermission('timing.view', resource.data.raceId) || (permission('personal.results') && ownsRecordedSplit(resource.data.raceId, resource.data.bibNumber));
      allow create: if isValidChipRead(request.resource.data) && request.resource.data.recordedBy == request.auth.uid && racePermission('timing.scan', request.resource.data.raceId) && !get(/databases/$(database)/documents/races/$(request.resource.data.raceId)).data.keys().hasAny(['completedAt']);
      allow update: if request.resource.data == resource.data && racePermission('timing.scan', resource.data.raceId);
      allow delete: if (isSuperAdmin() && raceScope(resource.data.raceId)) || racePermission('timing.correct', resource.data.raceId);
    }

    // A compact, organizer-published scoreboard for spectators. Raw timing
    // scans never become public: only the owner of the race (or an admin) can
    // write this collection, while anyone may read its non-sensitive summary.
    match /liveResults/{raceId} {
      allow read: if true;
      allow create, update: if request.resource.data.raceId == raceId && racePermission('results.publish', raceId)
        && (!getAfter(/databases/$(database)/documents/races/$(raceId)).data.keys().hasAny(['completedAt'])
          || (permission('timing.finish') && !get(/databases/$(database)/documents/races/$(raceId)).data.keys().hasAny(['completedAt']) && request.resource.data.updatedAt == getAfter(/databases/$(database)/documents/races/$(raceId)).data.completedAt));
      allow delete: if isSuperAdmin() && raceScope(raceId);
    }

    // ========== MEDAL ENGRAVING ORDERS ==========

    function isValidOrder(data) {
      return data.keys().hasAll(['runnerName', 'bibNumber', 'distance', 'finishingTime', 'status', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 7 && data.keys().size() <= 11
        && data.runnerName is string && data.runnerName.size() >= 1 && data.runnerName.size() <= 100
        && data.bibNumber is string && data.bibNumber.size() >= 1 && data.bibNumber.size() <= 20
        && data.distance is string && data.distance.size() >= 1 && data.distance.size() <= 50
        && data.finishingTime is string && data.finishingTime.size() >= 1 && data.finishingTime.size() <= 20
        && data.status is string && (data.status == 'queued' || data.status == 'inprogress' || data.status == 'ready' || data.status == 'completed')
        && data.createdAt is string
        && data.updatedAt is string
        && (!data.keys().hasAny(['rank']) || (data.rank is string && data.rank.size() <= 50))
        && (!data.keys().hasAny(['customInscription']) || (data.customInscription is string && data.customInscription.size() <= 150))
        && (!data.keys().hasAny(['ownerUid']) || data.ownerUid is string);
    }

    match /orders/{orderId} {
      allow read: if permission('engraving.view') || (permission('personal.engraving') && resource.data.get('ownerUid', null) == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data) && request.resource.data.status == 'queued' && (permission('engraving.create') || (permission('personal.engraving') && request.resource.data.ownerUid == request.auth.uid));
      allow update: if isValidOrder(request.resource.data) && permission('engraving.status') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if isSuperAdmin() || (permission('personal.engraving') && resource.data.get('ownerUid', null) == request.auth.uid && resource.data.status == 'queued');
    }

    // ========== RUNNER HIGHLIGHTS MARQUEE (THE PODIUM PULSE SYSTEM) ==========

    function isSafeHighlightPhoto(url) {
      return url is string
        && url.size() >= 1 && url.size() <= 900000
        && url.matches('^(https://[^\\s]+|http://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?/[^\\s]+|data:image/(jpeg|jpg|png|webp|gif|avif);base64,[A-Za-z0-9+/=]+)$');
    }

    function isValidHighlight(data) {
      return data.keys().hasAll([
          'id', 'mode', 'runnerName', 'bibNumber', 'placement', 'distance',
          'chipTime', 'pace', 'raceName', 'raceDate', 'photoUrl',
          'borderPreset', 'cornerGeometry', 'accentColor', 'glowIntensity',
          'surfaceFinish', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.mode in ['solo', 'duo', 'group']
        && data.runnerName is string && data.runnerName.size() >= 1 && data.runnerName.size() <= 80
        && data.bibNumber is string && data.bibNumber.size() >= 1 && data.bibNumber.size() <= 24
        && data.placement is string && data.placement.size() >= 1 && data.placement.size() <= 40
        && data.distance is string && data.distance.size() >= 1 && data.distance.size() <= 30
        && data.chipTime is string && data.chipTime.size() >= 1 && data.chipTime.size() <= 30
        && data.pace is string && data.pace.size() >= 1 && data.pace.size() <= 30
        && data.raceName is string && data.raceName.size() >= 1 && data.raceName.size() <= 100
        && data.raceDate is string && data.raceDate.size() >= 1 && data.raceDate.size() <= 30
        && isSafeHighlightPhoto(data.photoUrl)
        && data.borderPreset in [
          'liquid-gold', 'cyber-hud', 'sonic-wave', 'holo-foil', 'carbon-minimal',
          'neon-circuit', 'obsidian-chrome', 'crimson-inferno', 'aurora-borealis',
          'vintage-prestige', 'titanium-blade', 'emerald-matrix'
        ]
        && data.cornerGeometry in ['rounded', 'sharp', 'tactical', 'hex-crest', 'ticket-notch']
        && data.accentColor is string && data.accentColor.size() >= 4 && data.accentColor.size() <= 20
        && data.glowIntensity is number && data.glowIntensity >= 0 && data.glowIntensity <= 100
        && data.surfaceFinish in ['matte', 'glossy', 'topo', 'carbon-weave', 'halftone']
        && data.createdAt is string && data.updatedAt is string
        && (!data.keys().hasAny(['secondaryAccentColor']) || (data.secondaryAccentColor is string && data.secondaryAccentColor.size() >= 4 && data.secondaryAccentColor.size() <= 20))
        && (!data.keys().hasAny(['cardEffect']) || data.cardEffect in ['sheen-sweep', 'prism-glint', 'ember-rise', 'radar-scan', 'pulse-aura', 'none'])
        && (!data.keys().hasAny(['headerStyle']) || data.headerStyle in ['crown-bezel', 'floating-notch', 'bottom-dock'])
        && (!data.keys().hasAny(['borderWidthPx']) || (data.borderWidthPx is number && data.borderWidthPx >= 2 && data.borderWidthPx <= 6))
        && (!data.keys().hasAny(['scrimStrength']) || (data.scrimStrength is number && data.scrimStrength >= 30 && data.scrimStrength <= 95))
        && (!data.keys().hasAny(['partnerName']) || (data.partnerName is string && data.partnerName.size() <= 80))
        && (!data.keys().hasAny(['partnerBibNumber']) || (data.partnerBibNumber is string && data.partnerBibNumber.size() <= 24))
        && (!data.keys().hasAny(['partnerPhotoUrl']) || data.partnerPhotoUrl == '' || isSafeHighlightPhoto(data.partnerPhotoUrl))
        && (!data.keys().hasAny(['teamName']) || (data.teamName is string && data.teamName.size() <= 80))
        && (!data.keys().hasAny(['groupPhotoLayout']) || data.groupPhotoLayout in ['collage', 'single'])
        && (!data.keys().hasAny(['groupMembers']) || (data.groupMembers is list && data.groupMembers.size() <= 6))
        && (!data.keys().hasAny(['soloSplitTime']) || (data.soloSplitTime is string && data.soloSplitTime.size() <= 30))
        && (!data.keys().hasAny(['partnerSplitTime']) || (data.partnerSplitTime is string && data.partnerSplitTime.size() <= 30))
        && (!data.keys().hasAny(['combinedAvgPace']) || (data.combinedAvgPace is string && data.combinedAvgPace.size() <= 30))
        && (!data.keys().hasAny(['gunTime']) || (data.gunTime is string && data.gunTime.size() <= 30))
        && (!data.keys().hasAny(['splitPace']) || (data.splitPace is string && data.splitPace.size() <= 30))
        && (!data.keys().hasAny(['runClub']) || (data.runClub is string && data.runClub.size() <= 60))
        && (!data.keys().hasAny(['raceId']) || (data.raceId is string && data.raceId.size() <= 64))
        && (!data.keys().hasAny(['raceCode']) || (data.raceCode is string && data.raceCode.size() <= 30))
        && (!data.keys().hasAny(['badgeStamp']) || (data.badgeStamp is string && data.badgeStamp.size() <= 30))
        && (!data.keys().hasAny(['achievements']) || (data.achievements is list && data.achievements.size() <= 10))
        && (!data.keys().hasAny(['participatedEvents']) || (data.participatedEvents is list && data.participatedEvents.size() <= 12))
        && (!data.keys().hasAny(['pinned']) || data.pinned is bool)
        && (!data.keys().hasAny(['expiresAt']) || (data.expiresAt is string && data.expiresAt.size() <= 30))
        && (!data.keys().hasAny(['createdBy']) || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    match /runnerHighlights/{highlightId} {
      allow read: if true;
      allow create, update: if isValidId(highlightId) && permission('highlights.manage') && isValidHighlight(request.resource.data);
      allow delete: if isSuperAdmin() || permission('highlights.manage');
    }

    match /system/highlightsConfig {
      allow read: if true;
      allow create: if permission('highlights.settings')
        && (!request.resource.data.keys().hasAny(['pinPodiumFirst','filterRaceId','hideExpired']) || permission('highlights.playlist'));
      allow update: if permission('highlights.settings')
        && (!changed(['pinPodiumFirst','filterRaceId','hideExpired']) || permission('highlights.playlist'));
      allow delete: if isSuperAdmin();
    }

    function canAccessPresetData(presetData) {
      return isSuperAdmin()
        || callerDoc().data.role == 'admin'
        || presetData.ownerUid == request.auth.uid
        || request.auth.uid in presetData.get('editorIds', []);
    }

    function canAccessPreset(presetId) {
      return exists(/databases/$(database)/documents/routePresets/$(presetId))
        && canAccessPresetData(get(/databases/$(database)/documents/routePresets/$(presetId)).data);
    }

    match /routePresets/{presetId} {
      allow read: if permission('routes.view') && canAccessPresetData(resource.data);
      allow create: if isValidId(presetId) && permission('routes.create') && request.resource.data.ownerUid == request.auth.uid;
      allow update: if permission('routes.edit') && canAccessPresetData(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (!changed(['archived']) || permission('routes.archive'));
      allow delete: if isSuperAdmin();

      match /drafts/{draftId} {
        allow read: if permission('routes.view') && canAccessPreset(presetId);
        allow create, update: if isValidId(draftId) && permission('routes.edit') && canAccessPreset(presetId);
        allow delete: if isSuperAdmin();

        match /markers/{markerId} {
          allow read: if permission('routes.view') && canAccessPreset(presetId);
          allow create, update: if isValidId(markerId) && permission('routes.edit') && canAccessPreset(presetId);
          allow delete: if isSuperAdmin() || (permission('routes.edit') && canAccessPreset(presetId));
        }
      }

      match /versions/{versionId} {
        allow read: if permission('routes.view') && canAccessPreset(presetId);
        allow create: if isValidId(versionId) && permission('routes.publish') && canAccessPreset(presetId);
        allow update, delete: if false;
      }
    }

    match /races/{raceId}/routeBindings/{distanceId} {
      allow read: if true;
      allow create, update: if isValidId(distanceId) && racePermission('routes.assign', raceId);
      allow delete: if isSuperAdmin() && raceScope(raceId);
    }

    match /publishedRaceRoutes/{publicationId} {
      allow get, list: if resource.data.get('status', '') == 'published' || permission('routes.view');
      allow create, update: if isValidId(publicationId) && (permission('routes.publish') || permission('routes.assign'));
      allow delete: if isSuperAdmin();
    }

    match /raceRouteCatalog/{entryId} {
      allow read: if true;
      allow create, update: if isValidId(entryId) && (permission('routes.publish') || permission('routes.assign'));
      allow delete: if isSuperAdmin();
    }

    match /routeJobs/{jobId} {
      allow read: if permission('routes.view');
      allow create, update: if isValidId(jobId) && permission('routes.edit');
      allow delete: if isSuperAdmin();
    }

    match /routeAudit/{eventId} {
      allow read: if permission('routes.view');
      allow create: if isValidId(eventId) && (permission('routes.edit') || permission('routes.publish') || permission('routes.assign') || permission('routes.archive'));
      allow update, delete: if false;
    }
  }
}
