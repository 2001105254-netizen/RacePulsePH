# GEMINI_API_KEY: Unused scaffold variable; RacePulsePH makes zero generative AI runtime calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public legal and business transparency variables (safe for client bundle)
VITE_COMPANY_NAME="RacePulsePH"
VITE_BUSINESS_ADDRESS="[BUSINESS_ADDRESS]"
VITE_SUPPORT_EMAIL="events@racepulseph.com"
VITE_JURISDICTION="Republic of the Philippines"
