rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // This is the immutable Firebase Auth identity of the platform owner.
    // It provides a recovery path when a legacy Firestore access document is
    // missing, stale, or cannot be read by Storage rules.
    function isPlatformOwner() {
      return request.auth != null && request.auth.token.get('email', '') == 'kiahzeh@gmail.com';
    }
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function access() { return firestore.exists(/databases/(default)/documents/userAccess/$(request.auth.uid)) ? firestore.get(/databases/(default)/documents/userAccess/$(request.auth.uid)).data : {'status':'active','overrides':{},'scope':profile().role in ['admin','superadmin'] ? 'all' : 'owned-assigned','raceIds':[]}; }
    function hasStoredPermission(action, defaultAllowed) {
      let acc = access();
      let p = acc.get('permissions', {});
      let o = acc.get('overrides', {});
      return (action in o ? o[action] : (action in p ? p[action] : defaultAllowed)) == true;
    }
    function can(action) {
      let role = profile().role;
      let fallback = role in ['admin','superadmin','organizer'];
      return request.auth != null && (isPlatformOwner() || (
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && access().status == 'active'
        && (role == 'superadmin' || (
          (role != 'organizer' || profile().approved)
          && hasStoredPermission(action, fallback)
          && hasStoredPermission('race.view', fallback)
        ))
      ));
    }
    function scope(raceId) {
      let race = firestore.get(/databases/(default)/documents/races/$(raceId)).data;
      // Super Admins can manage artwork for every event. This explicit branch
      // keeps legacy selected/owned access records from blocking poster/bib
      // uploads after a user has been promoted.
      return isPlatformOwner() || profile().role == 'superadmin' || access().scope == 'all' || (access().scope == 'selected' && raceId in access().raceIds)
        || (access().scope == 'owned-assigned' && (race.createdBy == request.auth.uid || request.auth.uid in race.get('organizerIds', [])));
    }
    match /race-bib-fonts/{ownerUid}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && can('race.bibs')
        && file.matches('^[a-zA-Z0-9._-]+\\.(woff2|woff|ttf|otf|WOFF2|WOFF|TTF|OTF)$')
        && request.resource.contentType != null
        && request.resource.contentType.matches('^(font/(woff2|woff|ttf|otf|sfnt)|application/(font-woff|font-woff2|x-font-woff|x-font-ttf|x-font-otf|vnd\\.ms-opentype|octet-stream))$')
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == ownerUid && can('race.bibs');
    }
    match /race-assets/{ownerUid}/{raceId}/{file} {
      allow read: if true;
      function assetAction() { return file.matches('payment-qr.*') ? 'payment.configure' : file.matches('bib-.*') ? 'race.bibs' : 'race.artwork'; }
      function writeAllowed() { return request.auth != null && request.auth.uid == ownerUid && can(assetAction()) && (firestore.exists(/databases/(default)/documents/races/$(raceId)) ? scope(raceId) : can('race.create')); }
      function isRaceImage() { return request.resource.contentType != null && request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif|avif)') && file.matches('^[a-zA-Z0-9._-]+\\.(png|jpg|jpeg|webp|gif|avif|PNG|JPG|JPEG|WEBP|GIF|AVIF)$'); }
      function isRouteGpx() {
        return file.matches('route-.*[.]gpx')
          && (request.resource.contentType.matches('application/gpx[+]xml')
            || request.resource.contentType.matches('application/xml')
            || request.resource.contentType.matches('text/xml')
            || request.resource.contentType == 'application/octet-stream');
      }
      allow create, update: if writeAllowed()
        && raceId.matches('^[a-zA-Z0-9_-]{1,64}$')
        && file.matches('^[a-zA-Z0-9._-]+\\.[a-zA-Z0-9]+$')
        && (
          (isRaceImage() && request.resource.size < 8 * 1024 * 1024)
          || (isRouteGpx() && file.matches('^[a-zA-Z0-9._-]+\\.(gpx|GPX)$') && request.resource.size < 50 * 1024 * 1024)
        );
      allow delete: if writeAllowed();
    }
    function canHighlight(action) {
      let role = profile().role;
      let fallback = role in ['admin','superadmin'];
      return request.auth != null && (isPlatformOwner() || (
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && access().status == 'active'
        && (role == 'superadmin' || (
          (role != 'organizer' || profile().approved)
          && hasStoredPermission(action, fallback)
          && hasStoredPermission('highlights.view', fallback)
        ))
      ));
    }
    match /highlight-assets/{ownerUid}/{highlightId}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && canHighlight('highlights.manage')
        && highlightId.matches('^[a-zA-Z0-9_-]{1,64}$')
        && file.matches('^[a-zA-Z0-9._-]+\\.(png|jpg|jpeg|webp|gif|avif|PNG|JPG|JPEG|WEBP|GIF|AVIF)$')
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif|avif)')
        && request.resource.size < 8 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == ownerUid && canHighlight('highlights.manage');
    }
    function canRoute(action) {
      let role = profile().role;
      let fallback = role in ['admin','superadmin','organizer'];
      return request.auth != null && (isPlatformOwner() || (
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && access().status == 'active'
        && (role == 'superadmin' || (
          (role != 'organizer' || profile().approved)
          && hasStoredPermission(action, fallback)
          && hasStoredPermission('routes.view', fallback)
        ))
      ));
    }
    function canRoutePublish() {
      return canRoute('routes.publish') && canRoute('routes.edit');
    }
    match /route-private/{ownerUid}/{presetId}/{file} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerUid || isPlatformOwner() || profile().role == 'superadmin' || access().scope == 'all')
        && canRoute('routes.view');
      allow create, update: if request.auth != null
        && (request.auth.uid == ownerUid || isPlatformOwner() || profile().role == 'superadmin' || access().scope == 'all')
        && (canRoute('routes.edit') || canRoute('routes.media'))
        && presetId.matches('^[a-zA-Z0-9_-]{1,64}$')
        && file.matches('^[a-zA-Z0-9._-]+\\.(gpx|GPX|json|JSON|png|jpg|jpeg|webp|PNG|JPG|JPEG|WEBP)$')
        && (file.matches('.*\\.(gpx|GPX)$') ? request.resource.size < 50 * 1024 * 1024 : request.resource.size < 8 * 1024 * 1024);
      allow delete: if request.auth != null
        && (request.auth.uid == ownerUid || isPlatformOwner() || profile().role == 'superadmin')
        && canRoute('routes.edit');
    }
    match /route-published/{publicationId}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null
        && canRoutePublish()
        && publicationId.matches('^[a-zA-Z0-9_-]{1,64}$')
        && file.matches('^[a-zA-Z0-9._-]+\\.(gpx|GPX|json|JSON|png|jpg|jpeg|webp|PNG|JPG|JPEG|WEBP)$')
        && (file.matches('.*\\.(gpx|GPX)$') ? request.resource.size < 50 * 1024 * 1024 : request.resource.size < 8 * 1024 * 1024);
      allow delete: if request.auth != null && (isPlatformOwner() || profile().role == 'superadmin');
    }
  }
}
